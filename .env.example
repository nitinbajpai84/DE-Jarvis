# Copy to .env (git-ignored). NEVER commit real values. NEVER paste these in a chat.

# --- Databricks Free Edition ---
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
DATABRICKS_HTTP_PATH=/sql/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_CATALOG=jarvis

# --- Slack ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxxx
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#all-jarvis-ops-testing

# --- Google Gemini: powers the headless deepagents team (agents_loader.py),
#     used for unattended Phase 5 CI runs. Not needed for interactive Claude
#     Code sessions (Phases 1-4) -- those run on the Claude Code session itself. ---
GOOGLE_API_KEY=

# --- Optional: cheap model for the Hermes ops agent ---
OPENROUTER_API_KEY=
